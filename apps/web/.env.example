# WEB ENV VARS

# Get these from the "env" discord channel
NEXT_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get this from your local postgres instance
DATABASE_URL=postgresql://poetryverse:poetryverse-pg-2@db:5432/poetryverse

# URL for the backend API
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# URL for NextAuth (set to canonical URL of the web app)
NEXTAUTH_URL=http://localhost:3000
