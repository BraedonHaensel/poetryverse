# WEB ENV VARS

# Get these from a PoetryVerse team member
NEXT_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal API URL for server-side requests (Docker Compose overrides this to http://api:3001)
NEXT_INTERNAL_API_URL=http://localhost:3001

# URL for NextAuth (set to canonical URL of the web app)
NEXTAUTH_URL=http://localhost:3000

# For development outside of Docker, provide the URL for your local PostgreSQL database instance
# Example: "postgresql://<username>:<password>@localhost:5432/poetryverse"
# DATABASE_URL=
