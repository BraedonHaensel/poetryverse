FROM node:lts-bookworm

WORKDIR /app

# Install workspace dependencies needed to run Prisma CLI.
COPY package.json package-lock.json ./
COPY packages/database/package.json packages/database/package.json
RUN npm ci

# Copy Prisma schema and migrations.
COPY packages/database packages/database

# Generate Prisma Client after schema is available.
RUN npm run db:generate --workspace=packages/database

CMD ["npm", "run", "db:deploy", "--workspace=packages/database"]
