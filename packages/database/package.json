{
  "name": "@seng513/database",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.4.0",
    "@prisma/adapter-pg": "^7.4.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "prisma": "^7.4.0",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^7.4.2"
  }
}
